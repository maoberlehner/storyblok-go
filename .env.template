# Content Delivery API preview token; required to run the site.
STORYBLOK_PREVIEW_TOKEN=

# Public origin for canonical URLs and the sitemap. `make run` and `make up`
# default to their local origins.
SITE_URL=

# Management API space ID and personal access token, used by the schema CLI and
# the sba CLI.
STORYBLOK_SPACE=
STORYBLOK_TOKEN=

# Signs form tokens against spam. Use a long random value in production, the
# same for every instance. `make run` and `make up` default to a dev value.
FORM_SECRET=
