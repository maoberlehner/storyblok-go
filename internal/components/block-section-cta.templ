package components

templ blockSectionCta(b *BlockSectionCta) {
	<section { editable(ctx, b)... } class={ section(ctx, b) } aria-labelledby={ ElementID(b) + "-heading" }>
		<div class="block-section-cta__layout">
			<div class="block-section-cta__content">
				<h2 class="block-section-cta__heading" id={ ElementID(b) + "-heading" }>{ b.Heading }</h2>
				if b.Text != "" {
					<p class="block-section-cta__text">{ b.Text }</p>
				}
			</div>
			if button := b.Button(); button != nil {
				@baseButton(*button)
			}
		</div>
	</section>
}
